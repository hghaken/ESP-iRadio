include/build_stamp.h

# KiCad (KiCad/esp-iradio): backups, caches, locks, per-user project state
*-backups/
fp-info-cache
*.lck
_autosave-*
\#auto_saved_files\#
*.kicad_prl
KiCad/esp-iradio/ref/
# JLCPCB Tools output (regenerated); its project.db (LCSC assignments) is committed
KiCad/esp-iradio/jlcpcb/gerber/
KiCad/esp-iradio/jlcpcb/production_files/
# loose Gerbers of tools/jlcfab.py (the zip next to them is committed)
KiCad/esp-iradio/jlcpcb/gerbers/

# STEP models of the LCSC parts (26 MB); recreate with easyeda2kicad, see KiCad/esp-iradio/NOTES.md
KiCad/esp-iradio/lib/lcsc.3dshapes/*.step

# Python byte code (KiCad/esp-iradio/tools)
__pycache__/

# PCB autorouter work files (Specctra DSN/SES, Freerouting logs) and the placement check board
KiCad/esp-iradio/route/
KiCad/esp-iradio/_placement_check.kicad_pcb
